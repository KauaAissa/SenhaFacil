# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/senha_facil?schema=public"

# ─── JWT ──────────────────────────────────────────────────
# Use `openssl rand -hex 64` to generate a strong secret for production
JWT_SECRET="change-me-to-a-64-char-random-hex-string-in-production"
JWT_EXPIRES_IN="1h"

# ─── App ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS (comma-separated list of allowed origins) ───────
ALLOWED_ORIGINS="http://localhost:8081"

# ─── Firebase Cloud Messaging ─────────────────────────────
# Obtenha em: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Cole a chave privada entre aspas — as quebras de linha viram \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"
