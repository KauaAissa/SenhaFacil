# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://senha_facil:senha_facil@localhost:5432/senha_facil?schema=public"

# ─── JWT ──────────────────────────────────────────────────
# Use `openssl rand -hex 64` to generate a strong secret for production
JWT_SECRET="change-me-to-a-64-char-random-hex-string-in-production"
JWT_EXPIRES_IN="1h"

# ─── App ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Leave unset locally. Set only after verifying the trusted proxy chain.
# Do not enable unrestricted trust of client-supplied forwarding headers.
# TRUST_PROXY_HOPS=1

# ─── CORS (comma-separated list of allowed origins) ───────
ALLOWED_ORIGINS="http://localhost:8081"
# ─── Mobile ──────────────────────────────────────────────
# Set in apps/mobile/.env (gitignored)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000 (Android emulator)
# No celular fisico, use o IP da rede local do computador.
# ─── Firebase Cloud Messaging ─────────────────────────────
# Obtenha em: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
# Preferred locally: absolute path to a private file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative when GOOGLE_APPLICATION_CREDENTIALS is not configured:
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada entre aspas — as quebras de linha viram \n
FIREBASE_PRIVATE_KEY=

# --- Optional guided password AI (server only; never EXPO_PUBLIC_) ---
# Create a Gemini API key in Google AI Studio and configure it privately.
# Defaults to disabled. Enabling without a key fails startup explicitly.
AI_PASSWORD_ENABLED=false
GEMINI_API_KEY=
GEMINI_PASSWORD_MODEL=gemini-3.5-flash-lite
# Prototype budget: total attempted calls per UTC day for this API process.
# Also enforced: 5/minute and 20/day per account, 2 concurrent calls globally.
AI_PASSWORD_DAILY_LIMIT=200
