{
  "expo": {
    "name": "Senha Fácil",
    "slug": "senha-facil",
    "scheme": "senhafacil",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/icon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#155C50"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.senhafacil.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para proteger o acesso ao seu cofre de senhas."
      }
    },
    "android": {
      "package": "com.senhafacil.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#155C50"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "react-native-quick-crypto",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#155C50"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para proteger o acesso ao seu cofre de senhas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf7a3e81-97af-4127-93fa-945791f84f71"
      }
    },
    "owner": "senhafacil"
  }
}
