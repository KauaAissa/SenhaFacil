{
  "name": "senha-facil",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @senha-facil/api dev",
    "dev:mobile": "pnpm --filter @senha-facil/mobile dev",
    "dev:mobile:client": "pnpm --filter @senha-facil/mobile dev:client",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:crypto": "pnpm --filter @senha-facil/crypto test",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @senha-facil/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @senha-facil/api exec prisma migrate deploy",
    "db:studio": "pnpm --filter @senha-facil/api exec prisma studio"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^10.12.0",
    "globals": "^16",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8"
  }
}
